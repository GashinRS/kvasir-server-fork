# =============================================================================
# Project name
# =============================================================================
# Explicit project name prevents clashes when multiple projects store compose
# files in a `compose/` directory (which would otherwise all default to "compose").

COMPOSE_PROJECT_NAME=kvasir

# =============================================================================
# Port overrides for simultaneous stacks
# =============================================================================
# The full compose stack runs on standard service ports by default (8080, 8123, etc.).
# Uncomment and adjust these if you need to run the full stack alongside another
# project or alongside dev services (which use 28xxx ports).
#
# Copy this file to compose/.env and uncomment the vars you want to change.
#
# | Variable                   | Default | Service             |
# | -------------------------- | ------- | ------------------- |
# | KVASIR_PORT_HTTP           | 8080    | Kvasir HTTP         |
# | KVASIR_PORT_CLICKHOUSE     | 8123    | ClickHouse HTTP API |
# | KVASIR_PORT_S3             | 8333    | SeaweedFS S3 API    |
# | KVASIR_PORT_KAFKA          | 9092    | Kafka bootstrap     |
# | KVASIR_PORT_KEYCLOAK       | 8280    | Keycloak HTTP       |
# | KVASIR_PORT_POSTGRES       | 5432    | PostgreSQL          |
# | KVASIR_PORT_OPENFGA_HTTP   | 8380    | OpenFGA HTTP        |
# | KVASIR_PORT_OPENFGA_GRPC   | 8381    | OpenFGA gRPC        |
#
# Example — shift to 28xxx to run alongside devservices or another project:
#
# KVASIR_PORT_HTTP=28080
# KVASIR_PORT_CLICKHOUSE=28123
# KVASIR_PORT_S3=28333
# KVASIR_PORT_KAFKA=29092
# KVASIR_PORT_KEYCLOAK=28280
# KVASIR_PORT_POSTGRES=25432
# KVASIR_PORT_OPENFGA_HTTP=28380
# KVASIR_PORT_OPENFGA_GRPC=28381

# =============================================================================
# SELinux suffix for bind mounts
# =============================================================================
# ONLY needed on SELinux-enabled systems (Fedora, RHEL, CentOS with SELinux enforcing)
# Most developers (Ubuntu, macOS, Windows, CI) should leave this EMPTY
#
# Default: Empty (no SELinux labeling - works for 95% of users)
# SELINUX_SUFFIX=

# If you're on a SELinux system (Fedora/RHEL), uncomment this:
# SELINUX_SUFFIX=:z,ro
