# Port overrides for standalone dev services.
#
# These non-default ports ensure dev services (used by `just dev-services-up` and Maven-managed
# devservices) don't clash with the full compose stack running at its standard ports.
#
# Used explicitly via `--env-file compose/.env.devservices` — never auto-loaded.
# Full stack ports are the standard defaults baked into compose.devservices.yml and compose.kvasir.yml.

COMPOSE_PROJECT_NAME=kvasir-dev

KVASIR_PORT_CLICKHOUSE=28123
KVASIR_PORT_S3=28333
KVASIR_PORT_KAFKA=29092
KVASIR_PORT_KEYCLOAK=28280
KVASIR_PORT_POSTGRES=25432
KVASIR_PORT_OPENFGA_HTTP=28380
KVASIR_PORT_OPENFGA_GRPC=28381
