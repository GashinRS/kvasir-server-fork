global:
  host: {{ .StateValues.kvasirHost }}
  ingressRoutes:
    matchHost: true
    tlsEnabled: {{ .StateValues.tlsEnabled }}
    proxy: {{ .StateValues.proxy }}
  {{- if eq .Environment.Name "kind" }}
    tls:
      secretName: kvasir-tls
  {{- end }}

  env:
    - name: KVASIR_BASE_URI
      value: "http{{ if .StateValues.tlsEnabled }}s{{ end }}://{{ .StateValues.kvasirHost }}/"
    - name: KVASIR_WEBCLIENT_URI
      value: "http{{ if .StateValues.tlsEnabled }}s{{ end }}://{{ .StateValues.kvasirHost }}/_ui/"

  deploymentStrategy:
    type: Recreate

  quarkus:
    httpPort: 8080
    metricsPort: 9000


  {{- if eq .Environment.Name "kind" }}
  truststore:
    secretName: oidc-truststore-secret
  {{- end }}

  oidc:
    enabled: true
    authServerUrl: "http{{ if .StateValues.tlsEnabled }}s{{ end }}://{{ .StateValues.keycloakHost }}/realms/quarkus"
    clientId: "quarkus-app"
    clientSecret: "secret"
    realm: "quarkus"
    existingSecret: ""
    clientIdSecretKey: ""
    clientSecretSecretKey: ""
    realmSecretKey: ""
  keycloakAdmin:
    enabled: true
    username: "kcadmin"
    password: {{ .StateValues.keycloakAdminPassword }}
    realm: "master"
    authAdminServerUrl: "http{{ if .StateValues.tlsEnabled }}s{{ end }}://{{ .StateValues.keycloakHost }}"


  minio:
    host: "minio.minio.svc.cluster.local"
    port: "9000"
    skipTlsVerify: true
    useTls: false
    accessKey: "admin"
    secretKey: {{ .StateValues.minioRootpassword }}
    existingSecret: ""
    accessKeySecretKey: ""
    secretKeySecretKey: ""

  kafka:
    bootstrapServers: "kvasir-kafka-kafka-bootstrap.kafka.svc.cluster.local:9092"

  clickhouse:
    host: "clickhouse-clickhouse.clickhouse.svc.cluster.local"
    port: "8123"
