nodeSelector:
  ingress-ready: 'true'
tolerations:
  - key: node-role.kubernetes.io/master
    operator: Equal
    effect: NoSchedule
  - key: node-role.kubernetes.io/control-plane
    operator: Equal
    effect: NoSchedule

ports:
  web:
    nodePort: 32080
  websecure:
    nodePort: 32443
    tls:
      enabled: true

