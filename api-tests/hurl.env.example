# Kvasir hurl test variables — copy to hurl.env and adjust for your environment.
# hurl.env is git-ignored; this file is git-tracked as a reference.
# Run locally: just api-test
#
# Only URLs needed here — the sole runtime variable is `ts`, injected by just.

keycloak_url=http://localhost:8280
realm=kvasir
kvasir_url=http://localhost:8080
kss_vocab=https://kvasir.discover.ilabt.imec.be/vocab#
