            "type" : "string",
            "description" : "The type of the assertion.",
            "examples" : [ "kss:AssertEmptyResult" ],
            "enum" : [ "https://kvasir.discover.ilabt.imec.be/vocab#AssertEmptyResult", "https://kvasir.discover.ilabt.imec.be/vocab#AssertNonEmptyResult" ]
          },
          "kss:query" : {
            "type" : "string",
            "description" : "The GraphQL query string to be executed.",
            "examples" : [ "{ id ex_givenName(_: \"Bob\") }" ]
          }
        }
      },
