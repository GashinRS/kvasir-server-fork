          "nrOfDeletes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "errorMessage" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "ChangeRequestInput" : {
        "type" : "object",
        "required" : [ "@context", "kss:assert", "kss:insert" ],
        "properties" : {
          "@context" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "The JSON-LD context for the change request.",
            "examples" : [ {
              "kss" : "https://kvasir.discover.ilabt.imec.be/vocab#",
              "ex" : "http://example.org/"
            } ]
          },
          "kss:assert" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Assertion"
            },
            "description" : "List of assertions to be checked before applying the change request."
          },
          "kss:with" : {
            "type" : [ "string", "null" ],
            "description" : "Optional GraphQL query where matches are required to be found for the change request to be applied. Results are bound to the field names in the query and can be used in the insert and delete operations (via templates).",
            "examples" : [ "{ id ex_givenName(_: \"Bob\") }" ]
          },
          "kss:insert" : {
            "type" : "array",
            "items" : { },
            "description" : "List of triples to be inserted, or a [JSONata](https://jsonata.org) template string to be applied to the results of the with-clause.",
            "examples" : [ [ {
              "@id" : "ex:123",
              "ex:givenName" : "Bob"
            } ] ]
          }
        }
      },
      "ChangeResultCode" : {
        "type" : "string",
        "enum" : [ "COMMITTED", "ASSERTION_FAILED", "NO_MATCHES", "TOO_MANY_MATCHES", "VALIDATION_ERROR", "INTERNAL_ERROR" ]
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
