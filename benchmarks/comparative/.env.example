# ── CSS ───────────────────────────────────────────────────────────────────────
CSS_BASE_URL=http://localhost:3000
CSS_POD_NAME=benchmark
CSS_EMAIL=benchmark@example.com
CSS_PASSWORD=benchmark-password

# ── Kvasir baseline ───────────────────────────────────────────────────────────
KVASIR_BASE_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:8280
KEYCLOAK_REALM=kvasir

KVASIR_POD_NAME=benchmark-compare
KVASIR_CLIENT_ID=benchmark-compare
KVASIR_CLIENT_SECRET=change-me

# Scenario 1 (File I/O): auto-ingest-rdf is disabled
KVASIR_POD_NAME_S1=benchmark-compare
KVASIR_CLIENT_ID_S1=benchmark-compare
KVASIR_CLIENT_SECRET_S1=change-me

# Scenario 2 (RDF Query): auto-ingest-rdf is enabled
KVASIR_POD_NAME_S2=benchmark-compare-rdf
KVASIR_CLIENT_ID_S2=benchmark-compare-rdf
KVASIR_CLIENT_SECRET_S2=change-me

# ── Kvasir candidate (simultaneous A/B mode) ──────────────────────────────────
# Set KVASIR_CANDIDATE_BASE_URL to enable the "kvasir-candidate" platform.
# Leave empty to use sequential mode (just bench-ab + just bench-ab-report).
#
# Simultaneous mode: run `just bench-ab-up` to start both instances, then:
#   KVASIR_CANDIDATE_BASE_URL=http://localhost:28081 just bench-compare \
#     -- --scenario 1 --platform kvasir kvasir-candidate s3
#
# Sequential mode (default): run `just bench-ab` — it swaps the image
# between two runs automatically and labels results correctly for the report.
KVASIR_CANDIDATE_BASE_URL=
KVASIR_CANDIDATE_KEYCLOAK_URL=
KVASIR_CANDIDATE_POD_NAME=benchmark-compare-candidate
KVASIR_CANDIDATE_CLIENT_ID=benchmark-compare-candidate
KVASIR_CANDIDATE_CLIENT_SECRET=change-me
KVASIR_CANDIDATE_POD_NAME_S2=benchmark-compare-candidate-rdf
KVASIR_CANDIDATE_CLIENT_ID_S2=benchmark-compare-candidate-rdf
KVASIR_CANDIDATE_CLIENT_SECRET_S2=change-me

# ── S3 Direct ─────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:28333
S3_ACCESS_KEY=kvasir
S3_SECRET_KEY=kvasirkvasir
S3_REGION=us-east-1
S3_BUCKET_NAME=benchmark

# ── Benchmark parameters ─────────────────────────────────────────────────────
ITERATIONS=5
WARMUP_ITERATIONS=1
CONCURRENCY_LEVELS=4,8,16,32,64

# Number of SAREF measurement records per sensor for Scenario 2
RDF_DATASET_SIZE=10000

# ── Output ────────────────────────────────────────────────────────────────────
RESULTS_DIR=results
