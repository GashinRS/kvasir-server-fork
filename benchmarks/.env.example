# ── Kvasir server ────────────────────────────────────────────────────────────
KVASIR_BASE_URL=http://localhost:8080
KVASIR_POD_NAME=benchmark

# ── Keycloak (OIDC) ──────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8280
KEYCLOAK_REALM=kvasir

# Client credentials for a service-account client that has access to the pod.
# Create the client (enable service account) and grant it access to the pod.
CLIENT_ID=benchmark-client
CLIENT_SECRET=change-me

# ── Data generation ───────────────────────────────────────────────────────────
NR_OF_SENSORS=20
RECORDS_PER_SENSOR=100000
# Number of measurements per N-Triples file uploaded to S3
INSERT_BATCH_SIZE=10000
# How many S3 files to upload before waiting for auto-ingestion to commit them
UPLOAD_WAVE_SIZE=20

# ── Query benchmark ───────────────────────────────────────────────────────────
QUERY_ITERATIONS=5
# Which benchmark(s) to run: slice, time_range, single_id_lookup, latest_measurements, or all
BENCHMARKS=slice
# Number of sensors to sample for the single-ID lookup benchmark (benchmark 3)
SINGLE_ID_LOOKUP_SENSORS=5
TIME_RANGE_SECONDS=60

# ── State file ────────────────────────────────────────────────────────────────
# Written by load_data.py and read by run_benchmarks.py
STATE_FILE=benchmark_state.json

